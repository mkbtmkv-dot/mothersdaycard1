{
  "version": 2,
  "functions": {
    "server.js": {
      "runtime": "@vercel/node",
      "includeFiles": "frames/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}